rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /plants/{plant} {
      function isSignedIn() {
        return request.auth.uid != null;
      }
      // allow read: if true;
      // allow  write: if isSignedIn()
      allow read: if false;
      allow write: if false;
    }
  }
}